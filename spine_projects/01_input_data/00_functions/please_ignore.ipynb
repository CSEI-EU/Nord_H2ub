    "input_costs_columns = {}\n",
    "\n",
    "for _, row in df_model_units_relations.iterrows():\n",
    "    unit = row['Unit']\n",
    "    input_node = row['Input1']\n",
    "\n",
    "    if input_node in [\"water_source\", \"co2_source\", \"o2_source\"]:\n",
    "        # Check if column already exists\n",
    "        col_name = f\"{input_node}_costs\"\n",
    "        if col_name in df_energy_prices.columns:\n",
    "            continue  # Skip if already added\n",
    "            \n",
    "        matching = df_other_costs[df_other_costs.iloc[:, 0] == input_node]\n",
    "        if not matching.empty:\n",
    "            value = matching.iloc[0, 2]\n",
    "            if pd.notna(value):\n",
    "                # Create the column values\n",
    "                column_data = ['unit', 'unit__from_node', unit, input_node, run_name, 'vom_cost']\n",
    "                column_data += [value] * len(df_time)\n",
    "\n",
    "                input_costs_columns[col_name] = column_data\n",
    "\n",
    "# Get reference values from power_wholesale_in\n",
    "wholesale_in_col = 'power_wholesale_in'\n",
    "if wholesale_in_col in df_energy_prices.columns:\n",
    "    reference_values = list(df_energy_prices[wholesale_in_col].iloc[6:].values)\n",
    "else:\n",
    "    reference_values = [0] * len(df_time)\n",
    "\n",
    "# Now add RES connection costs based on selected power sources\n",
    "if RES_powers:\n",
    "    res_connection_mapping = {\n",
    "        'Solar plant': {\n",
    "            'Object type': 'connection',\n",
    "            'Relationship class 1': 'connection__from_node',\n",
    "            'Relationship class 2': 'connection__to_node',\n",
    "            'Object name 1': 'pl_wholesale_solar',\n",
    "            'Object name 2': 'pl_solar_PPA',\n",
    "            'Node 1': 'power_wholesale',\n",
    "            'Node 2': 'solar_plant_node',\n",
    "            'Alternative': run_name,\n",
    "            'Parameter name': 'connection_flow_cost',\n",
    "        },\n",
    "        'Wind onshore': {\n",
    "            'Object type': 'connection',\n",
    "            'Relationship class 1': 'connection__from_node',\n",
    "            'Relationship class 2': 'connection__to_node',\n",
    "            'Object name 1': 'pl_wholesale_wind_onshore',\n",
    "            'Object name 2': 'pl_wind_onshore_PPA',\n",
    "            'Node 1': 'power_wholesale',\n",
    "            'Node 2': 'wind_onshore_plant_node',\n",
    "            'Alternative': run_name,\n",
    "            'Parameter name': 'connection_flow_cost',\n",
    "        },\n",
    "        'Wind offshore': {\n",
    "            'Object type': 'connection',\n",
    "            'Relationship class 1': 'connection__from_node',\n",
    "            'Relationship class 2': 'connection__to_node',\n",
    "            'Object name 1': 'pl_wholesale_wind_offshore',\n",
    "            'Object name 2': 'pl_wind_offshore_PPA',\n",
    "            'Node 1': 'power_wholesale',\n",
    "            'Node 2': 'wind_offshore_plant_node',\n",
    "            'Alternative': run_name,\n",
    "            'Parameter name': 'connection_flow_cost',\n",
    "        }\n",
    "    }\n",
    "    \n",
    "    # Iterate through selected power sources\n",
    "    for power_source in RES_powers:\n",
    "        # Skip Grid as it doesn't need these connections\n",
    "        if power_source == 'Grid':\n",
    "            continue\n",
    "            \n",
    "        if power_source in res_connection_mapping:\n",
    "            mapping = res_connection_mapping[power_source]\n",
    "            \n",
    "            # Check if this power source has PPA enabled\n",
    "            has_ppa = ppa_values.get(power_source, False) if ppa_values else False\n",
    "            \n",
    "            # Determine PPA price: use actual price if PPA=True, otherwise 0\n",
    "            if has_ppa:\n",
    "                ppa_price = ppa_price_values.get(power_source, 0)\n",
    "            else:\n",
    "                ppa_price = 0\n",
    "            \n",
    "            # Check if columns already exist\n",
    "            col1_name = f\"{mapping['Object name 1']}_out\"\n",
    "            col2_name = f\"{mapping['Object name 1']}_in\"\n",
    "            col3_name = f\"{mapping['Object name 2']}_in\"\n",
    "            \n",
    "            if col1_name in df_energy_prices.columns:\n",
    "                continue  # Skip if already added\n",
    "            \n",
    "            # Column 1: wholesale connection from_node (copy from power_wholesale_in)\n",
    "            col1_data = [\n",
    "                mapping['Object type'],\n",
    "                mapping['Relationship class 1'],\n",
    "                mapping['Object name 1'],\n",
    "                mapping['Node 1'],\n",
    "                mapping['Alternative'],\n",
    "                mapping['Parameter name']\n",
    "            ]\n",
    "            col1_data += reference_values\n",
    "            \n",
    "            input_costs_columns[col1_name] = col1_data\n",
    "            \n",
    "            # Column 2: wholesale connection to_node (negative values)\n",
    "            col2_data = [\n",
    "                mapping['Object type'],\n",
    "                mapping['Relationship class 2'],\n",
    "                mapping['Object name 1'],\n",
    "                mapping['Node 1'],\n",
    "                mapping['Alternative'],\n",
    "                mapping['Parameter name']\n",
    "            ]\n",
    "            col2_data += [-float(v) for v in reference_values]\n",
    "            \n",
    "            input_costs_columns[col2_name] = col2_data\n",
    "            \n",
    "            # Column 3: PPA connection - ALWAYS added with conditional price\n",
    "            col3_data = [\n",
    "                mapping['Object type'],\n",
    "                mapping['Relationship class 1'],\n",
    "                mapping['Object name 2'],\n",
    "                mapping['Node 2'],\n",
    "                mapping['Alternative'],\n",
    "                mapping['Parameter name']\n",
    "            ]\n",
    "            col3_data += [ppa_price] * len(df_time)  # Uses 0 if PPA=False, ppa_price if PPA=True\n",
    "            \n",
    "            input_costs_columns[col3_name] = col3_data\n",
    "\n",
    "# Build the output DataFrame from the columns (only if there are new columns to add)\n",
    "if input_costs_columns:\n",
    "    df_input_costs_data = pd.DataFrame.from_dict(input_costs_columns, orient='columns')\n",
    "    df_energy_prices = pd.concat([df_energy_prices, df_input_costs_data], axis=1)\n",
    "\n",
    "df_energy_prices.head(15)"
   ]
  },
