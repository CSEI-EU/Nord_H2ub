   "source": [
    "### CONNECTIONS ###\n",
    "df_connection_relation_parameter_data = object_relationship_connection_nodes(df_model_connections)\n",
    "\n",
    "# Add Alternatives Name\n",
    "df_connection_relation_parameter_data['Alternative'] = run_name\n",
    "\n",
    "# Update RES connection capacities based on selected RES capacities\n",
    "if RES_powers and RES_powers_capacities:\n",
    "    # Mapping of power sources to their connection names\n",
    "    res_capacity_mapping = {\n",
    "        'Solar plant': {\n",
    "            'connections': ['pl_wholesale_solar', 'pl_solar_PPA'],\n",
    "            'node': 'solar_plant_node'\n",
    "        },\n",
    "        'Wind onshore': {\n",
    "            'connections': ['pl_wholesale_wind_onshore', 'pl_wind_onshore_PPA'],\n",
    "            'node': 'wind_onshore_node'\n",
    "        },\n",
    "        'Wind offshore': {\n",
    "            'connections': ['pl_wholesale_wind_offshore', 'pl_wind_offshore_PPA'],\n",
    "            'node': 'wind_offshore_node'\n",
    "        }\n",
    "    }\n",
    "    \n",
    "    # Iterate through selected RES\n",
    "    for power_source in RES_powers:\n",
    "        # Skip Grid\n",
    "        if power_source == 'Grid':\n",
    "            continue\n",
    "        \n",
    "        if power_source in res_capacity_mapping:\n",
    "            # Get the capacity for this RES\n",
    "            res_capacity = RES_powers_capacities.get(power_source)\n",
    "            \n",
    "            if res_capacity is not None and pd.notna(res_capacity):\n",
    "                mapping = res_capacity_mapping[power_source]\n",
    "                \n",
    "                # Update all rows related to this RES's connections\n",
    "                for connection_name in mapping['connections']:\n",
    "                    # Find rows where Object_name matches the connection name\n",
    "                    # and Parameter is 'connection_capacity'\n",
    "                    mask = (\n",
