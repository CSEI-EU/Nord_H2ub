    "metadata = ['Object type', 'Object name', 'Alternative', 'Parameter name']\n",
    "\n",
    "df_user_constraint_series = pd.DataFrame(\n",
    "    metadata +df_time['DateTime'].tolist(),\n",
    "    columns=['DateTime ' + area]\n",
    ")\n",
    "\n",
    "# Map each power source to its availability factor series\n",
    "availability_factor_mapping = {\n",
    "    'Solar plant': df_PV_availabilityfactors_values['unit_availability_factor'].tolist(),\n",
    "    'Wind onshore': df_wind_availabilityfactors_values['unit_availability_factor_onshore'].tolist(),\n",
    "    'Wind offshore': df_wind_availabilityfactors_values['unit_availability_factor_offshore'].tolist(),\n",
    "}\n",
    "\n",
    "for power_source in RES_powers:\n",
    "    if power_source == 'Grid':\n",
    "        continue\n",
    "    if power_source in res_connection_constraint_mapping:\n",
    "        constraint_name = res_connection_constraint_mapping[power_source]['User_constraint_name']\n",
    "\n",
    "        if ppa_values.get(power_source):\n",
    "            ppa_type = ppa_type_values.get(power_source)\n",
    "            ppa_capacity = ppa_capacity_values.get(power_source)\n",
    "\n",
    "            if ppa_type == 'Pay-as-produced':\n",
    "                availability_factors = availability_factor_mapping.get(power_source)\n",
    "                values = [ppa_capacity * af for af in availability_factors]\n",
    "            else:  # Base load\n",
    "                values = [ppa_capacity] * len(df_time)\n",
    "        else:\n",
    "            values = [RES_powers_capacities.get(power_source)] * len(df_time)\n",
    "\n",
    "        col_data = ['user_constraint', constraint_name, run_name, 'right_hand_side'] + list(values)\n",
    "        df_user_constraint_series[constraint_name] = col_data\n",
    "\n",
    "# Drop the column heads for RES  \n",
    "df_user_constraint_series.columns = ['DateTime ' + area] + [''] * (len(df_user_constraint_series.columns) - 1)\n",
    "\n",
    "df_user_constraint_series.head(10)"
   ]
  },
