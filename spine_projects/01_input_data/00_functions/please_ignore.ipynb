    "# this should just be used when running it from the user interface\n",
    "with open(os.path.join(module_path, 'parameters.pkl'), 'rb') as file:\n",
    "    parameters = pickle.load(file)\n",
    "\n",
    "# Extract RES values\n",
    "RES_powers = parameters.get('powers', None)\n",
    "RES_powers_capacities = parameters.get('powers_capacities', {})\n",
    "\n",
    "# Add district heating - function is called later \n",
    "district_heating = parameters.get('district_heating')\n",
    "# Add oxygen \n",
    "oxygen = parameters.get('oxygen')\n",
    "\n",
    "# Extract PPA values\n",
    "ppa_values = parameters.get('ppa_values', None)\n",
    "ppa_capacity_values = parameters.get('ppa_capacity_values', None)\n",
    "ppa_price_values = parameters.get('ppa_price_values', None)\n",
    "ppa_type_values = parameters.get('ppa_type_values', None)\n",
    "\n",
    "\n",
    "# Filtering function to determine if an element should be included based on the active RES powers\n",
    "if RES_powers:\n",
    "    power_element_map = {\n",
    "        'Solar plant': ['solar_plant_node', 'pl_wholesale_solar', 'pl_solar_PPA'],\n",
    "        'Wind onshore': ['wind_onshore_plant_node', 'pl_wholesale_wind_onshore', 'pl_wind_onshore_PPA'],\n",
    "        'Wind offshore': ['wind_offshore_plant_node', 'pl_wholesale_wind_offshore', 'pl_wind_offshore_PPA'],\n",
    "    }\n",
    "    \n",
    "    elements_to_remove = {\n",
    "        element\n",
    "        for power, elements in power_element_map.items()\n",
    "        if power not in RES_powers\n",
    "        for element in elements\n",
    "    }\n",
    "\n",
    "    def matches_active(name):\n",
    "        return name not in elements_to_remove\n",
    "else:\n",
    "    def matches_active(name):\n",
    "        return True"
   ]
