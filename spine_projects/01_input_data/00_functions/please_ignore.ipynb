    "# Create the dataframe based on object _node_node one \n",
    "df_object__node_node_definition = df_object_node_node.copy()\n",
    "\n",
    "# Drop the excessive columns\n",
    "df_object__node_node_definition.drop(columns = ['Parameter', 'Value', 'Alternative'], inplace = True)\n",
    "\n",
    "# Rename remainging columns \n",
    "df_object__node_node_definition.rename(columns = \n",
    "                                       {'Object_class':'Object_class_1',\n",
    "                                        'Object_name': 'Object_name_1', \n",
    "                                        'Node1': 'Object_name_2', \n",
    "                                        'Node2': 'Object_name_3'}, inplace = True)\n",
    "\n",
    "# Add missing columns \n",
    "df_object__node_node_definition.insert(3, 'Object_class_2', 'node', allow_duplicates=True)\n",
    "df_object__node_node_definition.insert(5, 'Object_class_3', 'node', allow_duplicates=True)\n",
    "\n",
    "# Add district heating\n",
    "if district_heating:\n",
    "    df_object__node_node_definition = pd.concat([df_object__node_node_definition, dh_sheets_mapping['Object__node_node_def']], ignore_index=True)\n",
    "\n",
    "df_object__node_node_definition.head(100)"
