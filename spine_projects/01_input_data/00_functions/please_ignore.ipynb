    "            'entity_class_name': 'connection__from_node__user_constraint',\n",
    "            'User_constraint_name': 'wind_offshore_PPA_fix_1',\n",
    "            'Object_type': 'connection',\n",
    "            'Object_name': 'pl_wind_offshore_PPA',\n",
    "            'Node_name': 'wind_offshore_plant_node',\n",
    "            'Alternative': run_name,\n",
    "            'connection_flow_coefficient': 1\n",
    "        }\n",
    "    }\n",
    "    \n",
    "    # Iterate through selected power sources\n",
    "    rows = []\n",
    "    constraint_senses = []\n",
    "    for power_source in RES_powers:\n",
    "        if power_source == 'Grid':\n",
    "            continue\n",
    "        if power_source in res_connection_constraint_mapping:\n",
    "            rows.append(res_connection_constraint_mapping[power_source])\n",
    "            constraint_senses.append('EQ' if ppa_values.get(power_source) else '<=')\n",
    "\n",
    "    df_user_constraint_relation_values = pd.concat([df_user_constraint_relation_values, pd.DataFrame(rows)], ignore_index=True)\n",
    "    df_user_constraint_values = pd.concat([df_user_constraint_values, pd.DataFrame({\n",
    "        'Object_name': [row['User_constraint_name'] for row in rows],\n",
    "        'Object_type': ['user_constraint' for _ in rows],\n",
    "        'Alternative': [row['Alternative'] for row in rows],\n",
    "        'constraint_sense': constraint_senses  \n",
    "    })], ignore_index=True)\n",
    "\n",
    "df_user_constraint_values.head()"
   ]
  },
