   "source": [
    "# Create combined DataFrame:\n",
    "df_object__node = pd.concat([df_unit_relation_parameter_data, df_connection_relation_parameter_data])\n",
    "df_object__node = df_object__node.reset_index(drop=True)\n",
    "\n",
    "# Rename 'Node' column to 'Object_to_from_name'\n",
    "df_object__node = df_object__node.rename(columns={'Node': 'Object_to_from_name'})\n",
    "\n",
    "# Add 'Object_name' column as second from last with value 'node'\n",
    "cols = df_object__node.columns.tolist()\n",
    "df_object__node.insert(3, 'Object_to_from', 'node')\n",
    "\n",
    "# Filter RES connections based on RES_powers\n",
    "df_object__node = df_object__node[\n",
    "    df_object__node['Object_name'].apply(matches_active)\n",
    "]\n",
    "\n",
    "# Update PPA capacities if PPA is selected\n",
    "if ppa_values:\n",
    "    ppa_object_to_tech = {\n",
    "        element: tech\n",
    "        for tech, elements in power_element_map.items()\n",
    "        for element in elements\n",
    "        if element.endswith('_PPA')\n",
    "    }\n",
    "\n",
    "    for obj_name, tech in ppa_object_to_tech.items():\n",
    "        if ppa_values.get(tech, False):\n",
    "            df_object__node.loc[\n",
    "                df_object__node['Object_name'] == obj_name,\n",
    "                'Value'\n",
    "            ] = ppa_capacity_values.get(tech)\n",
    "\n",
    "# Show df head for control\n",
    "df_object__node.head(100)"
   ]
  },
